{
  "manifest_version": 3,
  "name": "Tab Locker",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "Return to your default tab after a configurable time away, with a local activity log.",
  "permissions": ["tabs", "storage", "alarms"],
  "action": {
    "default_title": "Tab Locker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
  {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
]
}
